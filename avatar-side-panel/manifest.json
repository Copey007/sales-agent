{
  "manifest_version": 3,
  "name": "A-Gent Avatar",
  "version": "0.2.0",
  "description": "A-Gent live avatar side panel for Gmail and allowed CRMs. Draft only: it never sends email.",
  "action": {
    "default_title": "A-Gent",
    "default_icon": {
      "16": "icons/a-gent-logo-16.png",
      "32": "icons/a-gent-logo-32.png",
      "48": "icons/a-gent-logo-48.png",
      "128": "icons/a-gent-logo-128.png"
    }
  },
  "icons": {
    "16": "icons/a-gent-logo-16.png",
    "32": "icons/a-gent-logo-32.png",
    "48": "icons/a-gent-logo-48.png",
    "128": "icons/a-gent-logo-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://aisdr.a-gent.co/*",
    "https://esm.sh/*",
    "https://api.liveavatar.com/*"
  ]
}
